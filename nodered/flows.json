    {
        "id": "inject-gas-101",
        "type": "inject",
        "z": "tab-edge-floor1",
        "name": "Capteur Gaz 101 (Toutes les 2s)",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "2",
        "crontab": "",
        "once": true,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 210,
        "y": 120,
        "wires": [
            [
                "fn-gas-101"
            ]
        ]
    },
    {
        "id": "fn-gas-101",
        "type": "function",
        "z": "tab-edge-floor1",
        "name": "Edge Prétraitement - Gaz 101",
        "func": "let val = 250 + Math.random() * 50;\nmsg.topic = 'smartbuilding/bld-01/room-101/GAS';\nmsg.payload = {\n    sensorId: 'gas-101',\n    type: 'GAS',\n    value: Math.round(val * 10) / 10,\n    unit: 'ppm',\n    timestamp: Date.now()\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
        "y": 120,
        "wires": [
            [
                "mqtt-out-101"
            ]
        ]
    },
