# =====================================================================
#  Secrets de l'équipe Smart Building Emergency (étape 3)
#  1. Copier ce fichier en .env, ou lancer :
#        python infra/mqtt/gen_credentials.py --init-env
#     (crée .env et remplit les secrets vides avec des valeurs aléatoires)
#  2. Partager le .env par un canal privé. Il ne va JAMAIS sur Git.
#  Ce fichier .env.example, lui, est poussé : il ne contient aucune valeur.
# =====================================================================

# ---------- MQTT (personne 1, contrat 5) ----------
# Un mot de passe par compte (au moins 12 caractères, tous différents)
MQTT_BACKEND_PASSWORD=H8F28mAu4RCcoW0HFv9wrfTo
MQTT_DEVICE_PASSWORD=SbeJvnmZaiw5TaqXWeHv8o6R
MQTT_ML_PASSWORD=bRTfHoipJFDtKb7i7UmlR6wS
# Mot de passe du keystore du broker (broker.jks) et du truststore des clients Java (truststore.jks)
MQTT_KEYSTORE_PASSWORD=xqwEv9wfFSwRs3AmFbueGATq
MQTT_TRUSTSTORE_PASSWORD=ylrEfebdAaq0rgYIafuc917I
# Configuration HiveMQ utilisée : config.xml (ports 1883 et 8883) puis config-tls-only.xml (8883 seul)
HIVEMQ_CONFIG=config.xml
# Facultatif : IP du PC sur le Wi-Fi (ex. 192.168.1.20), ajoutée au certificat pour que l'ESP32 l'accepte
MQTT_BROKER_LAN_IP=

# ---------- IAM et API (personne 2, contrat 1) ----------
# Clé de signature des jetons JWT, au moins 32 caractères, la même pour iam et api
JWT_SECRET=5VNLDFZQ8NKxXxMnU3fCm7eH8BhsaDP0dZyMyGgs6c51orzG
